# GEMINI_API_KEY: Required only if server-side Gemini AI features are used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this application is hosted (e.g. https://your-app.vercel.app).
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret signing key for staff/admin auth tokens.
# Recommended in Vercel Environment Variables so sessions remain valid across deployments.
SESSION_SECRET=

# Optional server-side Super Admin credentials (strongly recommended on Vercel serverless).
# If left empty, claim your admin username and password directly in the app's first-run login form.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional custom directory for persistent JSON database & uploaded video files (VPS / Docker / Node servers).
PRODUCER_DATA_DIR=
